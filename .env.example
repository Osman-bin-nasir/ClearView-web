# The admin screen (footer → Admin).
#
# These are read by api/admin/session.js, on the server only — none of them is
# VITE_-prefixed, so none of them is compiled into the JavaScript the browser
# downloads. An admin check that shipped its own secret would be decoration.
#
# Make them with (this writes .env for you):
#   npm run admin:set -- you@example.com
#
# Or, to be shown the values rather than have them written to a file:
#   npm run admin:hash -- you@example.com
#
# Keep .env out of git (it is ignored) and add the same three variables, made
# separately, in Vercel → Settings → Environment Variables.

# The one address allowed to sign in.
ADMIN_EMAIL=

# scrypt:N:r:p:salt:hash — a hash, never the password.
#
# The separator is ":" rather than the usual "$": a "$" in this file is a
# variable reference and gets expanded, so a "$"-separated hash cannot survive
# being pasted here. Keep the value unquoted; it contains nothing dotenv, a
# shell or a dashboard field treats as special.
ADMIN_PASSWORD_HASH=

# Signs the session tokens. Rotate it to sign every admin out.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Publishing (the admin screen's Publish button).
#
# Publish commits two files to the repository — public/site-content.json and
# public/app-links.json — and the deploy follows the commit, which is how the
# live site changes without anyone typing git commands. Locally you do not need
# any of these: under `npm run dev` a publish writes the file into public/
# instead, and the commit stays yours to make.
#
# These are read by api/admin/publish.js, on the server only.

# A fine-grained GitHub token with Contents: read and write on this repository.
# Repository access → Only select repositories, then pick this one; then
# Permissions → Contents → Read and write. Nothing else is needed.
GITHUB_TOKEN=

# owner/name of the repository the commit goes to. Deliberately not guessed: a
# default would be a guess about which repository gets written to.
GITHUB_REPO=

# The branch Vercel deploys from. Leave it out and `main` is used.
GITHUB_BRANCH=
