# The admin screen (footer → Admin).
#
# These are read by api/admin/session.js, on the server only — none of them is
# VITE_-prefixed, so none of them is compiled into the JavaScript the browser
# downloads. An admin check that shipped its own secret would be decoration.
#
# Make them with:
#   node tools/make-admin-hash.mjs you@example.com
#
# Then keep this file out of git (.env is ignored) and add the same three
# variables in Vercel → Settings → Environment Variables.

# The one address allowed to sign in.
ADMIN_EMAIL=

# scrypt:N:r:p:salt:hash — a hash, never the password.
#
# The separator is ":" rather than the usual "$": a "$" in this file is a
# variable reference and gets expanded, so a "$"-separated hash cannot survive
# being pasted here. Keep the value unquoted; it contains nothing dotenv, a
# shell or a dashboard field treats as special.
ADMIN_PASSWORD_HASH=

# Signs the session tokens. Rotate it to sign every admin out.
ADMIN_SESSION_SECRET=
